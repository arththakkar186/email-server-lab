// /etc/bind/named.conf.local  -  authoritative zones for the lab
zone "maillab.test" {
    type master;
    file "/etc/bind/zones/db.maillab.test";
    allow-transfer { none; };
};

zone "56.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.56";
    allow-transfer { none; };
};
